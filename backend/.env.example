# Chapter 23 — The Memory House Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas or Local MongoDB)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chapter23_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/chapter23_db

# Security & Authentication
JWT_SECRET=chapter23_secure_jwt_secret_memory_house_2026
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Client Origin (CORS)
CLIENT_URL=http://localhost:5000

# Initial Admin Credentials (Seeded on first startup)
INITIAL_ADMIN_EMAIL=prachimohite1711@gmail.com
INITIAL_ADMIN_PASSWORD=Prachimohite@2309
INITIAL_ADMIN_NAME=Prachi Mohite

# Email Notification Service (Resend, Nodemailer, Gmail, SendGrid, etc.)
# If left empty, notifications log to console safely in simulation mode
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Chapter 23" <no-reply@chapter23memoryhouse.com>

# Cloudinary Storage for Customer Photographs (Optional - falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File Upload Limit
MAX_FILE_SIZE_MB=15
